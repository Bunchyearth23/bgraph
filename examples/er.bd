// Entities and the relations between them. A bare string in the block is a
// column, exactly as in `class`; what `er` adds is cardinality at each end
// of a relation, written after the label and read at the end nearest the
// entity it describes — `order -> line "contains" one many` is one order,
// many lines.
//
// entity <id> ["label"]
//   …and `- name` or `+ name` on its own line inside the block, drawn
//   as a ruled compartment under the name.
// <id> -> <id> ["label"] <from-card> <to-card>
//
// Every setting this genre takes is in docs/reference.md, under its name.

type er { title: "Ordering schema" }
graph { background: #0b1120 padding: 32 gap: 56 }

style entity { fill: #1e293b stroke: #38bdf8 1.4 font: 13 #e2e8f0 radius: 6 padding: 14 margin: 10 }
style edge   { stroke: #64748b 1.4 font: 11 #94a3b8 head: none }

entity customer "Customer" {
  - id: uuid PK
  - email: text
  - created_at: timestamptz
}

entity order "Order" {
  - id: uuid PK
  - customer_id: uuid FK
  - placed_at: timestamptz
  - total_cents: bigint
}

entity line "OrderLine" {
  - order_id: uuid FK
  - sku: text
  - qty: integer
}

entity address "Address" {
  - customer_id: uuid FK
  - line1: text
  - city: text
}

layout {
  place customer at (0, 0)
  place order right-of customer gap 120
  place line below order gap 56
  place address below customer gap 56
}

customer -> order   "places"    one many
order    -> line    "contains"  one one-many
customer -> address "ships to"  one zero-many
