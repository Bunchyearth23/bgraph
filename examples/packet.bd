type packet {
  title: "TCP header"
  width: 32
  ruler: on
}

graph { background: #0b1120 }

style node {
  fill: #1e293b
  stroke: #334155 1
  radius: 3
  font: 12 #e2e8f0
}

style flag extends node { fill: #422006 stroke: #f59e0b 1 }

node sport "Source port"       { bits: 0 15 }
node dport "Destination port"  { bits: 16 31 }
node seq   "Sequence number"   { bits: 32 63 }
node ack   "Acknowledgment number" { bits: 64 95 }
node off   "Offset"            { bits: 96 99 }
node rsv   "Rsvd"              { bits: 100 102 }
node flags "Flags" .flag       { bits: 103 111 }
node win   "Window"            { bits: 112 127 }
node sum   "Checksum"          { bits: 128 143 }
node urg   "Urgent pointer"    { bits: 144 159 }
