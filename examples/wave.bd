// A timing diagram. Each signal carries a wave string, one character per
// period, in the WaveDrom alphabet.
//
// signal <id> ["label"] <wave>
//
// Every setting this genre takes is in docs/reference.md, under its name.

type wave {
  title: "SPI transfer"
  period: 34
  lane: 26 16
  every: 1
}
graph { background: #0b1120 padding: 30 }
style signal { font: 12 #e2e8f0 stroke: #7dd3fc }

signal sclk "SCLK"  "p........."
signal cs   "~CS"   "10........1"
signal mosi "MOSI"  "x.=.=.=.=.x" { data: "cmd" "addr" "data" "crc" }
signal miso "MISO"  "z...=.=...z" { data: "ack" "status" }
signal busy "BUSY"  "0..1...0..."
