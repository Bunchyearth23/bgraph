// One shape, placed twice. The instance is a frame, so it anchors like any
// other group and `web.app` names a box inside it.
component service {
  node app "{{label}}"
  node db  "Database" below app gap 34
  app -> db "reads"
}

graph { title: "One shape, placed twice" padding: 28 }

use service as web  { label: "Web" }
use service as jobs right-of web gap 90 { label: "Jobs" }

web.app -> jobs.app "enqueues"
