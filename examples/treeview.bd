// The same tree as indented rows, one per line — a file listing, a menu, a
// taxonomy. Depth is the indent and order is the order written.
//
// entry <id> ["label"]
//
// Every setting this genre takes is in docs/reference.md, under its name.

// The same tree as indented rows — depth is the indent, order is the order
// written (W-041).
type treeview { title: "src/" row: 26 spacing: 14 }
graph { background: #0b1120 padding: 28 }
style entry { fill: #1e293b stroke: #334155 1 font: 12 #e2e8f0 radius: 4 padding: 8 }

entry src     "src/"
entry lib     "lib.rs"
entry parser  "parser.rs"
entry check   "check.rs"
entry solver  "layout.rs"
entry charts  "charts.rs"
entry render  "render_svg.rs"
entry lsp     "lsp.rs"

src -> lib
src -> parser
src -> check
src -> solver
solver -> charts
solver -> render
src -> lsp
