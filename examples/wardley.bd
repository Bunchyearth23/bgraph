// A Wardley map is `type quadrant` with its own axis names — no new archetype.

type quadrant {
  title: "Value chain"
  size: 520 360
  x-axis: "Genesis" "Commodity"
  y-axis: "Invisible" "Visible"
  quadrants: "Outsource" "Build" "Ignore" "Buy"
}
graph { background: #0b1120 padding: 34 }
style point { font: 12 #e2e8f0 }

point user   "User need"   0.72 0.95
point site   "Web site"    0.60 0.76
point api    "API"         0.45 0.58
point store  "Datastore"   0.78 0.36
point power  "Power"       0.96 0.10
