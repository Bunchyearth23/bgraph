// Boxes with a name and a list of members, placed by anchors like `free`. A
// bare string in the block is a member.
//
// class <id> ["label"]
//   …and `- name` or `+ name` on its own line inside the block, drawn
//   as a ruled compartment under the name.
//
// Every setting this genre takes is in docs/reference.md, under its name.

type class { title: "Ordering domain" }
graph { background: #0b1120 padding: 32 gap: 56 }

style class { fill: #1e293b stroke: #38bdf8 1.4 font: 13 #e2e8f0 radius: 6 padding: 14 margin: 10 }
style edge  { stroke: #64748b 1.4 font: 11 #94a3b8 }

class user "User" {
  - id: Uuid
  - email: String
  - name: String
}

class order "Order" {
  - id: Uuid
  - user_id: Uuid
  - total: Money
  - placed_at: DateTime
}

class line "OrderLine" {
  - order_id: Uuid
  - sku: String
  - qty: u32
}

class money "Money" {
  - amount: i64
  - currency: Iso4217
}

layout {
  place user at (0, 0)
  place order right-of user gap 90
  place line below order gap 44
  place money right-of order gap 90
}

user  -> order "places"
order -> line  "contains"
order -> money "totals" { dash: dashed }
