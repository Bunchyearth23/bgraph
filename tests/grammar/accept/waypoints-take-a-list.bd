// `via` takes a list, and each stop is parenthesised so the list needs no
// separator — `,` is already a statement separator (W-126).
node a "A"
node b "B"
node c "C"

a -> b via (200, 120)
a -> b via (200, 120) (300, 260)
a -> b via (left-of c gap 20) (below c gap 30)
a -> b via (col 3, row 2) (col 5, row 2)
a -> b "labelled" via (200, 120) { stroke: #f43f5e }
a -> b "either order" { stroke: #f43f5e } via (200, 120)


layout {
  place a at (0, 0)
  place b at (400, 0)
  place c at (200, 200)
}
