// Placement is explicit but relative: inserting a node moves what is anchored
// to it, instead of making you renumber coordinates.
graph { background: #ffffff padding: 18 gap: 30 }

style node { fill: #eef3ff stroke: #2563eb 1.3 font: 12 "Archivo" #1a1a1a radius: 5 padding: 12 }
style edge { stroke: #8a8a8a 1.2 font: 10 "Archivo" #8a8a8a }
style anchor { fill: #ffffff stroke: #1a1a1a 1.4 }

node a "a"                  .anchor at (0, 0)
node b "right-of a"         right-of a gap 44
node c "below a gap 30"     below a gap 30
node d "right-of b align top" right-of b gap 44 align top
