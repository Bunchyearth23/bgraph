// The compiler, end to end. The language server reuses the first four stages,
// which is what keeps the editor and the CLI from ever disagreeing.
graph { background: #ffffff padding: 18 gap: 26 flow: right }

style node  { fill: #eef3ff stroke: #2563eb 1.3 font: 12 "Archivo" #1a1a1a radius: 5 padding: 11 }
style edge  { stroke: #8a8a8a 1.2 font: 10 "Archivo" #8a8a8a }
style out   { fill: #ecf8ef stroke: #1b8a3a 1.3 }
style front { fill: #f0f0f0 stroke: #8a8a8a 1.2 }

node src   "source (.bd)" .front at (0, 0)
node parse "parser"       right-of src
node ast   "AST"          right-of parse
node check "check"        right-of ast
node lay   "layout"       right-of check
node svg   "SVG"          .out right-of lay gap 34 align top
node pdf   "PDF"          .out below svg gap 14

src -> parse
parse -> ast
ast -> check
check -> lay
lay -> svg
lay -> pdf
