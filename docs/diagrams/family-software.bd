// `type er` — a bare line in the block is a column; the cardinality is read at
// the end nearest the entity it describes.
type er { title: "Ordering schema" }
graph { background: #ffffff padding: 16 gap: 46 }

style entity { fill: #eef3ff stroke: #2563eb 1.3 font: 12 "Archivo" #1a1a1a radius: 5 padding: 11 }
style edge   { stroke: #8a8a8a 1.2 font: 10 "Archivo" #8a8a8a head: none }

entity customer "Customer" at (0, 0) {
  - id: uuid PK
  - email: text
}

entity order "Order" right-of customer gap 110 {
  - id: uuid PK
  - customer_id: uuid FK
  - total_cents: bigint
}

entity line "OrderLine" below order gap 40 {
  - order_id: uuid FK
  - sku: text
}

customer -> order "places"   one many
order    -> line  "contains" one one-many
