// How three files become one diagram. The prefix is what makes the second
// include safe: without it, two files declaring `api` would be an error.
graph { background: #ffffff padding: 18 gap: 30 flow: right }

style node  { fill: #eef3ff stroke: #2563eb 1.3 font: 12 "Archivo" #1a1a1a radius: 5 padding: 11 }
style file  { fill: #f0f0f0 stroke: #8a8a8a 1.2 font: 12 "Archivo" #1a1a1a radius: 5 padding: 11 }
style out   { fill: #ecf8ef stroke: #1b8a3a 1.3 }
style edge  { stroke: #8a8a8a 1.2 font: 10 "Archivo" #8a8a8a }

node house "house.bds\nstyles only" .file
node core  "core.bd\napi, db"      .file
node main  "main.bd\nui"           .node
node one   "one diagram\nui · core.api · core.db" .out

house -> main "include"
core  -> main "include … as core"
main  -> one


layout {
  place house at (0, 0)
  place core below house gap 20
  place main right-of house gap 60 align top
  place one right-of main gap 46
}
