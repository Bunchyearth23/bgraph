// bgraph DSL grammar
//
// Newlines are significant (they separate statements), so WHITESPACE covers
// only horizontal space and every rule spanning several lines consumes `sep`.

WHITESPACE = _{ " " | "\t" }
// `//`, not `#` — `#` is reserved for hex colors.
COMMENT    = _{ "//" ~ (!nl ~ ANY)* }

nl  = _{ "\r\n" | "\n" }
sep = _{ (nl | ";" | ",")* }

// A trailing hyphen is disallowed so `a->b` splits into `a` `->` `b`
// while keywords like `right-of` still read as one token.
ident  = @{ (ASCII_ALPHA | "_") ~ (ASCII_ALPHANUMERIC | "_" | ("-" ~ (ASCII_ALPHANUMERIC | "_")))* }
string = ${ "\"" ~ str_inner ~ "\"" }
str_inner = @{ (!("\"" | "\\") ~ ANY | "\\" ~ ANY)* }
number = @{ "-"? ~ ASCII_DIGIT+ ~ ("." ~ ASCII_DIGIT+)? ~ ("px" | "%")? }
// Any run of hex digits; `check` accepts only 3, 4, 6 or 8 of them. The
// tree-sitter lexer has no lookahead, so pinning the lengths here would have
// made one grammar reject `#1234567` and the other split it in two.
color  = @{ "#" ~ ASCII_HEX_DIGIT+ }

// Statements must be separated. Without it `slice a b` is ambiguous — is `b`
// a positional value or the start of the next statement?
file = { SOI ~ sep ~ (stmt ~ term)* ~ EOI }
term = _{ (nl | ";" | ",")+ | &EOI }

// `type_decl` precedes `edge_decl` so `type pie` is not read as the start of
// an edge; PEG backtracking still lets a node actually named `type` have edges.
// `edge_decl` precedes `item_decl` only for speed: `item_decl` would fail on
// the arrow anyway and backtrack.
stmt = _{ type_decl | graph_decl | style_decl | group_decl | edge_decl | item_decl }

type_decl  = { "type" ~ ident ~ block? }

// A container. Its block holds properties *and* statements, so a group nests.
// Its rectangle is derived from its members, not declared.
// No positional data: a group has no slots, it is a frame.
// `activate` is the same declaration under another word: its identifier names
// an *existing* item rather than declaring a new one, because a bar belongs to
// a participant that is already on the diagram (`D-024`).
group_kw    = { "group" | "activate" }
group_decl  = { group_kw ~ name ~ string? ~ class_ref* ~ placement? ~ group_block }
// Entries are separated, for the same reason statements are: without it
// `padding: 22 node a` cannot be told from a property with three values.
group_block = { "{" ~ sep ~ ((prop | stmt) ~ inner_term)* ~ "}" }
inner_term  = _{ (nl | ";" | ",")+ | &"}" }
graph_decl = { "graph" ~ block }
style_decl = { "style" ~ ident ~ ("extends" ~ ident)? ~ block }
// The leading identifier is the archetype's element keyword — `node`, `slice`,
// `field`. It is open here and closed by `check`, so adding an archetype never
// touches either grammar. Positional values are sugar for the properties the
// archetype declares.
// Data and `.class` may interleave: the leading `.` keeps them apart, so
// there is no reason to make the author remember an order.
// The placement and the block may come in either order — both read
// naturally, and `{` cannot be mistaken for a placement keyword.
// A hole may stand where a *name* goes, so a template can supply the id of the
// statement it fills — which is the whole point of repeating a line per row.
// Not where the archetype goes: the archetype decides which properties exist,
// so it has to be known before anything else can be checked.
name       = _{ ident | placeholder }
item_decl  = { ident ~ name ~ string? ~ (pos_value | class_ref)* ~ tail? }
tail       = _{ placement ~ block? | block ~ placement? }

// A placement keyword would otherwise be eaten as a bare-word value.
pos_value  = _{ !(place_kw) ~ value }
place_kw   = @{ ("at" | "right-of" | "left-of" | "below" | "above") ~ !(ASCII_ALPHANUMERIC | "_" | "-") }

// An edge may not start with a statement keyword. Without this, `style -> a`
// parses here (pest backtracks out of `style_decl`) but not in tree-sitter,
// whose lexer commits to the keyword. `check` reserves these names outright.
edge_decl  = { !(keyword) ~ name ~ arrow ~ name ~ string? ~ (pos_value | class_ref)* ~ block? }
// Atomic: a non-atomic rule would let implicit whitespace slip between the
// word and the boundary test, so `style -> a` would read the `-` as part
// of an identifier and the guard would never fire.
keyword    = @{ ("type" | "graph" | "style" | "node" | "group" | "activate") ~ !(ASCII_ALPHANUMERIC | "_" | "-") }

class_ref = { "." ~ ident }
arrow     = @{ "<->" | "<-" | "-->" | "..>" | "--" | "->" | ".." }

placement = _{ abs_pos | rel_pos }
abs_pos   = { "at" ~ point }
rel_pos   = { rel_dir ~ name ~ gap? ~ align? }
rel_dir    = { "right-of" | "left-of" | "below" | "above" }
gap        = { "gap" ~ number }
align      = { "align" ~ align_kw }
align_kw   = { "left" | "right" | "center" | "middle" | "top" | "bottom" }
point      = { "(" ~ number ~ "," ~ number ~ ")" }

// A line opening with `- ` or `+ ` is a member — a class's field, a table's
// column — and runs to the end of the line. The space is what keeps `-4` a
// number, and the marker is what lets properties still share a line.
block  = { "{" ~ sep ~ ((prop | member) ~ sep)* ~ "}" }
member = @{ ("-" | "+") ~ " " ~ (!nl ~ ANY)* }
// The lookahead stops a value list at the next `name:`, so several properties
// can share a line without needing a separator.
prop  = { ident ~ ":" ~ (!(ident ~ ":") ~ value)+ }
// `date` and `duration` come before `number`, or `2026-07-31` would lex as
// three numbers and `12d` as a number followed by an identifier.
// `{{name}}` is a hole the library fills at render time. It parses so a
// template stays editable — the editor would otherwise light up every line.
value       = _{ string | color | date | duration | number | placeholder | ident }
placeholder = @{ "{{" ~ (!"}}" ~ ANY)* ~ "}}" }
date     = @{ ASCII_DIGIT{4} ~ "-" ~ ASCII_DIGIT{2} ~ "-" ~ ASCII_DIGIT{2} }
duration = @{ ASCII_DIGIT+ ~ ("." ~ ASCII_DIGIT+)? ~ ("mo" | "w" | "d" | "h") ~ !(ASCII_ALPHANUMERIC | "_") }
