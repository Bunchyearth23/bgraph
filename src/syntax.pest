// bgraph DSL grammar
//
// Newlines are significant (they separate statements), so WHITESPACE covers
// only horizontal space and every rule spanning several lines consumes `sep`.

WHITESPACE = _{ " " | "\t" }
// `//`, not `#` — `#` is reserved for hex colors.
COMMENT    = _{ "//" ~ (!nl ~ ANY)* }

nl  = _{ "\r\n" | "\n" }
sep = _{ (nl | ";" | ",")* }

// A trailing hyphen is disallowed so `a->b` splits into `a` `->` `b`
// while keywords like `right-of` still read as one token.
part   = @{ (ASCII_ALPHA | "_") ~ (ASCII_ALPHANUMERIC | "_" | ("-" ~ (ASCII_ALPHANUMERIC | "_")))* }
// A qualified name — `core.api` — is *one* token. That is what settles the
// conflict `I-032` flagged: maximal munch takes the whole of it, so a leading
// `.box` is still unambiguously a class reference and no new sigil is needed
// (`D-029`). A dot must be followed by a name part, or `a.` would swallow the
// dot and leave the reader with a stranger error than "unknown name".
ident  = @{ part ~ ("." ~ part)* }
string = ${ "\"" ~ str_inner ~ "\"" }
str_inner = @{ (!("\"" | "\\") ~ ANY | "\\" ~ ANY)* }
number = @{ "-"? ~ ASCII_DIGIT+ ~ ("." ~ ASCII_DIGIT+)? ~ ("px" | "%")? }
// Any run of hex digits; `check` accepts only 3, 4, 6 or 8 of them. The
// tree-sitter lexer has no lookahead, so pinning the lengths here would have
// made one grammar reject `#1234567` and the other split it in two.
color  = @{ "#" ~ ASCII_HEX_DIGIT+ }

// Statements must be separated. Without it `slice a b` is ambiguous — is `b`
// a positional value or the start of the next statement?
file = { SOI ~ sep ~ (stmt ~ term)* ~ EOI }
term = _{ (nl | ";" | ",")+ | &EOI }

// `type_decl` precedes `edge_decl` so `type pie` is not read as the start of
// an edge; PEG backtracking still lets a node actually named `type` have edges.
// `edge_decl` precedes `item_decl` only for speed: `item_decl` would fail on
// the arrow anyway and backtrack.
stmt = _{ include_decl | component_decl | use_decl | layout_decl | note_decl | legend_decl | type_decl | graph_decl | style_decl | group_decl | edge_decl | item_decl }

// `include "shared.bds"` merges another file whole; with `as` its names come
// in under a prefix. Resolved before parsing reaches `check`, so by the time
// anything is validated there is one diagram (`D-029`).
include_decl = { "include" ~ string ~ ("as" ~ ident)? }

// A component is a file you did not have to make a file of. It is declared
// once and placed under a name, exactly as an included file is — so a
// component and an `include … as` are the same mechanism seen twice, and the
// prefixing that makes one safe makes the other safe too (`D-030`).
// A constraint adjusts one axis of already-placed boxes and never their
// order — that is what keeps `D-001` intact. An explicit `at` wins, and a
// contradiction is a warning naming both rather than a silent move (`D-031`).
// Text that belongs to no box: a caption, a warning, an aside. Placed by the
// same anchors as everything else, so it costs no new placement vocabulary —
// and it declares no name, which is what stops anything referring to it.
note_decl = { "note" ~ string ~ class_ref* ~ placement? ~ block? }

// Without explicit entries, the key uses classes with a `legend:` label.
legend_decl = { "legend" ~ !":" ~ class_ref* ~ placement? ~ legend_block? }
legend_block = { "{" ~ sep ~ ((prop+ | legend_entry) ~ inner_term)* ~ "}" }
legend_entry = { "entry" ~ string ~ class_ref* ~ block? }

// v2 placement lives apart from declarations. `place` is deliberately a
// statement rather than a property: geometry names its target and can carry
// the same ordinary anchor relations used by the placement engine.
layout_decl  = { "layout" ~ layout_block }
layout_block = { "{" ~ sep ~ (layout_stmt ~ inner_term)* ~ "}" }
layout_stmt  = _{ layout_place | layout_align | layout_equal_width | layout_equal_height | layout_row | layout_column }
layout_place = { "place" ~ name ~ placement }
layout_align = { "align" ~ layout_align_kw ~ name+ }
layout_align_kw = @{ "left" | "right" | "top" | "bottom" | "center-x" | "center-y" }
layout_equal_width = { "equal-width" ~ name+ }
layout_equal_height = { "equal-height" ~ name+ }
layout_series_member = { !layout_gap_kw ~ name }
layout_gap_kw = @{ "gap" ~ !(ASCII_ALPHANUMERIC | "_" | "-") }
layout_row = { "row" ~ layout_series_member+ ~ gap? }
layout_column = { "column" ~ layout_series_member+ ~ gap? }

component_decl = { "component" ~ ident ~ group_block }
use_decl       = { "use" ~ ident ~ "as" ~ ident ~ block? }

type_decl  = { "type" ~ ident ~ block? }

// A container. Its block holds properties *and* statements, so a group nests.
// Its rectangle is derived from its members, not declared.
// No positional data: a group has no slots, it is a frame.
// `activate` is the same declaration under another word: its identifier names
// an *existing* item rather than declaring a new one, because a bar belongs to
// a participant that is already on the diagram (`D-024`).
group_kw    = { "group" | "activate" }
group_decl  = { group_kw ~ name ~ string? ~ class_ref* ~ group_block }
// Entries are separated, for the same reason statements are: without it
// `padding: 22 node a` cannot be told from a property with three values.
group_block = { "{" ~ sep ~ ((prop | stmt) ~ inner_term)* ~ "}" }
inner_term  = _{ (nl | ";" | ",")+ | &"}" }
graph_decl = { "graph" ~ block }
style_decl = { "style" ~ ident ~ ("extends" ~ ident)? ~ block }
// The leading identifier is the archetype's element keyword — `node`, `slice`,
// `field`. It is open here and closed by `check`, so adding an archetype never
// touches either grammar. Positional values are sugar for the properties the
// archetype declares.
// Data and `.class` may interleave: the leading `.` keeps them apart, so
// there is no reason to make the author remember an order.
// Placement is declared in a scoped `layout` block; the optional tail here is
// only the inline property/member block.
// A hole may stand where a *name* goes, so a template can supply the id of the
// statement it fills — which is the whole point of repeating a line per row.
// Not where the archetype goes: the archetype decides which properties exist,
// so it has to be known before anything else can be checked.
name       = _{ ident | placeholder }
item_decl  = { ident ~ name ~ string? ~ (pos_value | class_ref)* ~ tail? }
tail       = _{ block }

// A placement keyword would otherwise be eaten as a bare-word value. So would
// `via`, which opens a waypoint list on an edge.
pos_value  = _{ !(place_kw) ~ value }
place_kw   = @{ ("at" | "right-of" | "left-of" | "below" | "above" | "via") ~ !(ASCII_ALPHANUMERIC | "_" | "-") }

// An edge may not start with a statement keyword. Without this, `style -> a`
// parses here (pest backtracks out of `style_decl`) but not in tree-sitter,
// whose lexer commits to the keyword. `check` reserves these names outright.
edge_decl  = { !(keyword) ~ name ~ arrow ~ name ~ string? ~ (pos_value | class_ref)* ~ edge_tail? }
// `via` and the property block may come in either order.
edge_tail  = _{ via_list ~ block? | block ~ via_list? }
// Atomic: a non-atomic rule would let implicit whitespace slip between the
// word and the boundary test, so `style -> a` would read the `-` as part
// of an identifier and the guard would never fire.
keyword    = @{ ("type" | "graph" | "style" | "node" | "group" | "activate" | "layout") ~ !(ASCII_ALPHANUMERIC | "_" | "-") }

class_ref = { "." ~ ident }
arrow     = @{ "<->" | "<-" | "-->" | "..>" | "--" | "->" | ".." }

placement = _{ abs_pos | rel_pos }
abs_pos   = { "at" ~ (cell | point) }
rel_pos   = { rel_dir ~ name ~ gap? ~ align? }
rel_dir    = { "right-of" | "left-of" | "below" | "above" }
gap        = { "gap" ~ number }
align      = { "align" ~ align_kw }
align_kw   = { "left" | "right" | "center-x" | "center-y" | "center" | "middle" | "top" | "bottom" }
point      = { "(" ~ number ~ "," ~ number ~ ")" }

// Waypoints: the places a line has to go through, in order (`D-034`). Each is
// parenthesised, which is what lets the list need no separator — `,` is
// already a statement separator — and what lets an absolute point, a grid cell
// and a place beside a box all be written the same way.
via_list   = { "via" ~ waypoint+ }
waypoint   = _{ cell | point | rel_point }
rel_point  = { "(" ~ rel_pos ~ ")" }
// `at (col 3, row 2)` is still `at`, in units declared once by `graph { grid }`.
// A coordinate system, not a solver — which is why it cannot break `D-001`.
cell       = { "(" ~ "col" ~ number ~ "," ~ "row" ~ number ~ ")" }

// A line opening with `- ` or `+ ` is a member — a class's field, a table's
// column — and runs to the end of the line. The space is what keeps `-4` a
// number, and the marker is what lets properties still share a line.
block  = { "{" ~ sep ~ ((prop | member) ~ sep)* ~ "}" }
member = @{ ("-" | "+") ~ " " ~ (!nl ~ ANY)* }
// The lookahead stops a value list at the next `name:`, so several properties
// can share a line without needing a separator.
prop  = { ident ~ ":" ~ (!(ident ~ ":") ~ value)+ }
// `date` and `duration` come before `number`, or `2026-07-31` would lex as
// three numbers and `12d` as a number followed by an identifier.
// `{{name}}` is a hole the library fills at render time. It parses so a
// template stays editable — the editor would otherwise light up every line.
value       = _{ string | color | date | duration | number | placeholder | ident }
placeholder = @{ "{{" ~ (!"}}" ~ ANY)* ~ "}}" }
date     = @{ ASCII_DIGIT{4} ~ "-" ~ ASCII_DIGIT{2} ~ "-" ~ ASCII_DIGIT{2} }
duration = @{ ASCII_DIGIT+ ~ ("." ~ ASCII_DIGIT+)? ~ ("mo" | "w" | "d" | "h") ~ !(ASCII_ALPHANUMERIC | "_") }
