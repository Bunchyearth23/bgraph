// bgraph — showcase of the whole language

graph {
  background: #0b1120
  padding: 40
  gap: 70
}

// ---- styles -----------------------------------------------------------
// `node` and `edge` are implicit: they apply to every node / every edge.

style node {
  font: 14 "Inter, system-ui, sans-serif" #e2e8f0
  fill: #1e293b
  stroke: #334155 1.5
  radius: 10
  padding: 16
  shadow: on
}

style edge {
  stroke: #475569 1.5
  font: 11 #94a3b8
  arrow: solid
}

style service {
  fill: #172554
  stroke: #3b82f6 1.5
}

style store extends service {
  shape: cylinder
  fill: #0f2e26
  stroke: #10b981 1.5
}

style gate {
  shape: diamond
  fill: #422006
  stroke: #f59e0b 1.5
}

style entry {
  shape: stadium
  fill: #4c0519
  stroke: #f43f5e 1.5
}

style hot {
  stroke: #f43f5e 2 dashed
  font: 11 #fda4af
}

// ---- layout -----------------------------------------------------------
// One absolute anchor; everything else hangs off a neighbour, so inserting
// a node shifts its dependents instead of breaking the whole picture.

node client  "Client"          .entry   at (0, 0)
node gateway "API\nGateway"    .service right-of client  gap 90
node auth    "Auth"            .gate    above gateway    gap 60
node orders  "Order\nService"  .service right-of gateway gap 90 align top
node billing "Billing"         .service below orders     gap 55 align left
node db      "Postgres"        .store   right-of orders  gap 90
node cache   "Redis"           .store   below db         gap 55 align center

// ---- edges ------------------------------------------------------------

client  ->  gateway "https"
gateway ->  auth    "verify" { router: ortho }
gateway ->  orders
orders  ->  db      "sql"
orders  ->  cache   "read-through" { router: ortho }
orders  ->  billing "charge" .hot
billing --> db
