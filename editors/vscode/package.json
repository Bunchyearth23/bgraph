{
  "name": "bgraph",
  "displayName": "bgraph",
  "description": "Syntax highlighting, live preview and language server for the bgraph diagram DSL",
  "version": "1.0.0",
  "publisher": "bunchyearth23",
  "private": true,
  "license": "LicenseRef-bgraph-noncommercial-1.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/Bunchyearth23/bgraph"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:bgraph",
    "onLanguage:markdown"
  ],
  "main": "./src/extension.js",
  "scripts": {
    "test": "node --test test/*.test.cjs"
  },
  "contributes": {
    "markdown.markdownItPlugins": true,
    "commands": [
      {
        "command": "bgraph.showPreview",
        "title": "Open Preview",
        "category": "bgraph",
        "enablement": "resourceLangId == bgraph"
      }
    ],
    "keybindings": [
      {
        "command": "bgraph.showPreview",
        "key": "ctrl+shift+v",
        "mac": "cmd+shift+v",
        "when": "editorLangId == bgraph && editorTextFocus"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "bgraph.showPreview",
          "when": "resourceLangId == bgraph",
          "group": "navigation"
        }
      ]
    },
    "configurationDefaults": {
      "[bgraph]": {
        "editor.tabSize": 2,
        "editor.insertSpaces": true
      }
    },
    "languages": [
      {
        "id": "bgraph",
        "aliases": [
          "bgraph"
        ],
        "extensions": [
          ".bd"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "bgraph",
        "scopeName": "source.bgraph",
        "path": "./syntaxes/bgraph.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "bgraph",
      "properties": {
        "bgraph.server.path": {
          "type": "string",
          "default": "bgraph-lsp",
          "description": "Path to the bgraph-lsp binary. Left as a bare name it is looked up on PATH."
        }
      }
    }
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  }
}
