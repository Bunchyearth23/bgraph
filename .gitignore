/target
/.tools/
/editors/zed/target
/tree-sitter-bgraph/node_modules
/tree-sitter-bgraph/package-lock.json
# The generated parser IS committed: Zed fetches the grammar from a git
# revision, so tree-sitter-bgraph/src must be in the tree.
# Zed and tree-sitter build outputs
/editors/zed/extension.wasm
/editors/zed/grammars/
/tree-sitter-bgraph/*.so
/tree-sitter-bgraph/*.dylib

# your scratch file — yours, not the repo's
/test.bd

# The VS Code extension's build inputs and outputs. `node_modules` is fetched
# by package.sh and bundled into the archive; the archive itself is a build
# artefact, not a source.
/editors/vscode/node_modules
/editors/vscode/package-lock.json
/editors/vscode/*.vsix

# Compiled documents. The .typ source and the diagram sources are the record.
/out
playground/public/bgraph.wasm
playground/node_modules
playground/dist
editors/vscode/bgraph.wasm
typst/bgraph.wasm

# graft's local graph cache — regenerable, not committed (run `graft build`).
/graft/
